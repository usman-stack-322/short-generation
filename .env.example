# ============================================================
# AI Shorts v2 — Phase 1 Environment Configuration (Option B)
# Copy this file to .env and fill in your credentials.
# ============================================================

# App Mode
APP_ENV=development
APP_NAME=AI Shorts Studio v2
STORAGE_MODE=local
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-vercel-app.vercel.app
DEFAULT_OWNER_EMAIL=owner@local.studio

# Database (Use Neon/Supabase PostgreSQL for Cloud; SQLite works for local dev)
# Example Neon URL: postgresql+psycopg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./ai_shorts_v2.db

# Cloudflare R2 (100 GB Celebrity Clips Storage — Zero Egress Fees)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ai-shorts-vault
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# AI Script Generation (Optional for Phase 1, used in Phase 2)
GEMINI_API_KEY=your_gemini_api_key

# Hybrid Worker Auth Token (Shared secret between Cloud API and your Local PC Worker)
WORKER_SHARED_SECRET=change-this-to-a-long-random-secret

# JWT Authentication Secret (Set a strong random value in production / Railway)
JWT_SECRET=change-this-to-a-long-random-jwt-secret
