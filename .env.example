GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
DATABASE_URL=sqlite:///./ai_shorts.db
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=
GENERATED_DIR=../generated
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TTS_PROVIDER=local
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SEED_DEMO=false
# Blank uses an automatically generated persistent local signing key.
APP_SECRET_KEY=
# Day 2 providers (all cloud credentials optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/callback
TOKEN_ENCRYPTION_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE=en-US-Neural2-D
ELEVENLABS_ALLOWED_VOICE_IDS=
PEXELS_API_KEY=
PIXABAY_API_KEY=
RESEARCH_PROVIDER=demo
RSS_FEEDS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss,https://news.google.com/rss/search?q=football%20when%3A3d&hl=en-US&gl=US&ceid=US%3Aen
RESEARCH_MAX_AGE_HOURS=72
# Explicit limited-verification drafts; never marks a story verified or enables publishing.
REVIEW_DRAFTS_ENABLED=false
ASSET_PROVIDER=commons
SCHEDULER_ENABLED=false
# Keep false until OAuth, channel permissions, and explicit publication confirmation are configured.
YOUTUBE_UPLOADS_ENABLED=false
# Optional comma-separated YouTube channel IDs to restrict publishing to test channels.
YOUTUBE_TEST_CHANNEL_IDS=

# Optional explicit Gemini availability fallback; leave blank to disable.
GEMINI_FALLBACK_MODEL=

# Trusted local source registry: publisher groups and scoped primary authority.
RESEARCH_SOURCES_FILE=app/research/sources.json
ANALYTICS_CACHE_SECONDS=900
ANALYTICS_REFRESH_SECONDS=60

# Bounded public historical discovery. Enable fallback per channel in Channels > Configure.
EVERGREEN_SEARCH_URL=https://www.bing.com/search
EVERGREEN_MAX_SOURCES=12

# Real-photo selection: Commons first (no key), optional contextual Pexels fallback.
# Use ASSET_PROVIDER=commons for live photography; demo uses neutral text cards.
# PEXELS_API_KEY stays backend-only. Only eligible PD/CC0/CC BY photos are automatic; no share-alike exports.

# Pexels new key issuance is paused (checked 2026-10-24). PEXELS_API_KEY is optional, for existing keys only.

# Wikimedia metadata and photo downloads require honest operator identification.
# Set your real contact email or public project HTTPS URL in backend/.env.
WIKIMEDIA_OPERATOR_CONTACT=
WIKIMEDIA_CACHE_SECONDS=900

# Optional local-only import: JSON member ID to permitted absolute root. Browser upload works without this.
LOCAL_MEDIA_ROOTS={}
